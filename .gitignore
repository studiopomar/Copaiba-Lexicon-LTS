*.log
warn-*.txt
xref-*.txt
pyi_out.txt
error_log.txt
crash_output.txt

# Testing & Cache
.pytest_cache/
.coverage
htmlcov/

# Operating System Files
.DS_Store
Thumbs.db

# IDEs and editors
.vscode/
.idea/
*.swp
*~
